# Server Configuration
PORT=3000
NODE_ENV=development

# Firebase & Alight Motion Configuration
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_IDT_URL=https://www.googleapis.com/identitytoolkit/v3/relyingparty
ALIGHT_VERIFY_URL=https://us-central1-alight-creative.cloudfunctions.net/verifyPurchase
FIREBASE_INSTANCE_ID_TOKEN=your_firebase_instance_id_token

# Stats Storage File Path (relative to project root or absolute)
STATS_FILE_PATH=data/stats.json

# API Security
API_SECRET_KEY=
CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
